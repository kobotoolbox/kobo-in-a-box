# Shared settings for the DigitalOcean test rig. Sourced by the local scripts.

NAME=${NAME:-kobo-box-ai}   # override for a second rig: NAME=kobo-box-gpu ./provision.sh

# Droplet size. See README for the tier each one simulates.
#   gpu-4000adax1-20gb  RTX 4000 Ada 20GB, 8 vCPU, 32GB   $0.76/h  (recommended)
#   gpu-6000adax1-48gb  RTX 6000 Ada 48GB, 8 vCPU, 64GB   $1.57/h  (field-server tier)
#   s-8vcpu-32gb-amd    CPU only,          8 vCPU, 32GB   $0.25/h  (minimum laptop tier)
SIZE=${SIZE:-gpu-4000adax1-20gb}   # override per run: SIZE=s-8vcpu-32gb-amd ./provision.sh

# Empty = try REGION_CANDIDATES in order and use the first with stock.
# Snapshots are region-bound: once parked, set REGION to where the snapshot lives.
REGION=
REGION_CANDIDATES="ams3 lon1 fra1 tor1 nyc2 atl1"

# NVIDIA AI/ML Ready image (drivers + CUDA) for GPU sizes; plain Ubuntu for CPU.
GPU_IMAGE=gpu-h100x1-base
CPU_IMAGE=ubuntu-24-04-x64

SSH_KEY_FILE=$HOME/.ssh/id_ed25519.pub
# Networks that block outgoing port 22: SSH_PORT=443 ./provision.sh makes sshd also
# listen on 443 (cloud-init), and every ssh call here uses it. Fresh droplets only.
SSH_PORT=${SSH_PORT:-22}

# Snapshot used by park.sh / provision.sh --from-snapshot
SNAPSHOT_NAME=${NAME}-snapshot
