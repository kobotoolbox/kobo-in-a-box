# RISA dashboard on the box (optional, early draft): ~/code/risa-dashboard at
# http://risa.kobo.local. Edit, then `./risa.sh up`. See README.md. SECRET_KEY, the
# database password and the create key are generated per box into RISA_SECRETS, not here.

# Built on the rig from risa-dashboard at this commit (`./risa.sh build <checkout>`);
# boxes get it from the content pack, like every other image
RISA_IMAGE=risa-dash:8013d3d
RISA_DB_IMAGE=postgis/postgis:16-3.5
# Published on loopback only; the edge nginx serves it as http://risa.kobo.local
RISA_PORT=8092
RISA_HOST=risa.kobo.local
RISA_SECRETS=/root/risa.secrets
# The database and the files (orthomosaics as COGs, uploads, printed pages, exports):
# in the box's backups. Orthomosaics are 0.5-5 GB each
RISA_DATA_DIR=/var/lib/kobo-box/risa

# Only the box's own Kobo (plain http on the box's closed network)
RISA_ALLOWED_SERVERS=http://kf.kobo.local
# Offline: no OpenFreeMap, Esri or OSM basemaps; the box's own map instead (below)
RISA_ONLINE_BASEMAPS=false
# Map labels: the box tile server's fonts (maps.sh build), through the edge (edge.conf)
RISA_GLYPHS_URL=http://risa.kobo.local/fonts/{fontstack}/{range}.pbf
# The box's OpenStreetMap map (maps.sh add), shown in RISA's basemap list as "Offline: ..."
MAPS_DIR=/opt/maps
RISA_BASEMAP_NAME=OpenStreetMap

# The web app's and the worker's processes. The worker converts orthomosaics (GDAL) and
# prints in Chromium, both heavy: keep it at 1 on kits that also run the AI models
RISA_WEB_CONCURRENCY=2
RISA_WORKER_CONCURRENCY=1
