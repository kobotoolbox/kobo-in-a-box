# Dashboards on the box (W9) and the box's kobo-mcp. Edit, then `./dash.sh up`. See README.md.
# Keys and the database password are generated per box into DASH_SECRETS, not here.

# Images, built online from these source trees (`./dash.sh build`), then saved into the
# content pack. kobo-dash `main` a2b86cd (2026-11-10: EspoCRM feeds, the world map); kobo-mcp
# branch w9-box-main (w9-box's MCP_OAUTH and PUBLIC_KOBO_SERVERS on main 3398982)
KOBO_DASH_SRC=/root/kobo-dash-src
KOBO_MCP_SRC=/root/kobo-mcp-src
DASH_IMAGE=kobo-dash:box
KOBO_MCP_IMAGE=kobo-mcp:box
DASH_DB_IMAGE=postgres:17
DASH_SECRETS=/root/dash.secrets

# Published on loopback only; the edge nginx serves them as http://dash.kobo.local and
# http://mcp.kobo.local
DASH_PORT=8086
MCP_PORT=8085

# kobo-mcp's tools for the box's agent: no deletes, no email (it needs the internet).
# `dashboards` adds the dashboard and evidence tools (~6.5k tokens more)
TOOL_PROFILES=analysis,forms,data,dashboards

# Maps: the content pack's maps/ folder. boundaries/ holds the deployment countries'
# administrative areas (`dash.sh boundaries`, online), tiles/ the basemap (`dash.sh tiles`)
MAPS_DIR=/opt/maps
BOUNDARIES_DIR=$MAPS_DIR/boundaries
# The basemap under maps. Empty: http://kobo.local/tiles/{z}/{x}/{y}.png when tiles/ has
# some (its attribution and deepest zoom from tiles/metadata.json), else none (areas,
# shading and points still draw). Set it to use other tiles
TILE_URL=
TILE_ATTRIBUTION=
TILE_MAX_ZOOM=
