# Offline maps on the box (MAPS-PLAN.md): an OpenStreetMap basemap of the deployment's
# countries at http://maps.kobo.local, for kobo-dash, QGIS and QField. Edit, then
# `./maps.sh up`. See README.md.

# The tile server: reads the basemap and draws image tiles from it on demand
TILESERVER_IMAGE=maptiler/tileserver-gl:v5.7.0
# Published on loopback only; the edge nginx serves it as http://maps.kobo.local
MAPS_PORT=8090

# The content pack's maps/ folder (dash.sh's boundaries/ are in it too). basemap/ holds
# the countries' map, its style, fonts and icons, and what's offered for download
MAPS_DIR=/opt/maps
BASEMAP_DIR=$MAPS_DIR/basemap
BOUNDARIES_DIR=$MAPS_DIR/boundaries

# Online only (`maps.sh build` / `add`). The pmtiles CLI cuts countries out of
# Protomaps' daily OpenStreetMap build; the box keeps a copy in the maps folder. No
# published checksums: the Linux x86_64 tarball's, pinned from the first download
PMTILES_VERSION=1.31.2
PMTILES_SHA256=3ed7dbf4ec2e6dfe5e25b6f70d1ffc932729f93c86db353bf514dd71010a312f
# Empty: Protomaps' newest daily build; or e.g. 20261105.pmtiles to repeat a build
PROTOMAPS_BUILD=
PROTOMAPS_BUILDS=https://build-metadata.protomaps.dev/builds.json
PROTOMAPS_URL=https://build.protomaps.com
# The style (npm @protomaps/basemaps) and its fonts and icons (github
# protomaps/basemaps-assets), pinned
PROTOMAPS_STYLE_VERSION=5.7.2
PROTOMAPS_ASSETS_COMMIT=028c18f713baecad011301ff7a69acc39bcc2ae7
STYLE_FLAVOR=light
# Countries' outlines when kobo-dash's fetcher can't get them (no dashboards, or the
# geoBoundaries API down): its gbOpen release on GitHub, at the commit the API serves
GEOBOUNDARIES_RELEASE=https://github.com/wmgeolab/geoBoundaries/raw/9469f09/releaseData/gbOpen
# Map labels: OpenStreetMap's own names fall back to this language
STYLE_LANG=es
# Deepest zoom cut out (Protomaps' build goes to 15: streets and buildings; 14 is about
# half the size). The tile server draws deeper zooms from z15's data
MAX_ZOOM=15
# Free disk a new map needs before it's cut (the map, its take-away copy, and the old ones
# until the new ones are in place)
MIN_FREE_GB=10
