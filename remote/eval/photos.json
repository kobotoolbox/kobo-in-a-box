{
  "about": "Photos for the model benchmark's image questions (MODELS-PLAN.md section 3), in eval/photos/, from Wikimedia Commons under open licences (credits below), resized to 1280 px wide. Each has KoboToolbox analysis questions and expected answers written by looking at the photo; 'why' says what makes it hard. The October photo (eval/water-point.jpg) stays in smoke-test.py's own set. Choice indexes count from 0; qualText passes when the answer has a word from each group in expect_words.",
  "photos": [
    {
      "file": "flood-damaged-house.jpg",
      "scene": "damage",
      "credit": "Ben Brennan (FEMA), public domain: https://commons.wikimedia.org/wiki/File:FEMA_-_41710_-_A_flood_damaged_home_in_Alaska.jpg",
      "why": "how bad the damage is; a tyre on the ground that isn't a vehicle",
      "cases": [
        {
          "type": "qualSelectOne",
          "question": "What condition is the house in?",
          "choices": [
            "Intact",
            "Minor damage",
            "Severely damaged or collapsed",
            "Under construction"
          ],
          "expect": [
            2
          ]
        },
        {
          "type": "qualSelectMultiple",
          "question": "What can you see in the photo?",
          "choices": [
            "Debris on the ground",
            "People",
            "A vehicle",
            "Trees"
          ],
          "expect": [
            0,
            3
          ]
        },
        {
          "type": "qualText",
          "question": "Describe the damage to the house in one sentence.",
          "expect_words": [
            [
              "tilt",
              "lean",
              "collaps",
              "shift",
              "foundation",
              "slid",
              "sunk",
              "sink",
              "destroy",
              "crooked",
              "angle",
              "off"
            ]
          ]
        }
      ]
    },
    {
