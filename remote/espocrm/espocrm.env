# Case management on the box (W11). Edit, then `./espocrm.sh up`. See README.md.
# Passwords and the bridge's API key are generated per box into ESPO_SECRETS, not here.

ESPO_IMAGE=espocrm/espocrm:9.3.11
ESPO_DB_IMAGE=mariadb:11.4
BRIDGE_IMAGE=python:3.13-slim
# Published on loopback only; the edge nginx serves it as http://cases.kobo.local
ESPO_PORT=8084
ESPO_SITE_URL=http://cases.kobo.local
ESPO_SECRETS=/root/espocrm.secrets
# Dates and times shown to staff (e.g. Africa/Dar_es_Salaam); stored in UTC either way
ESPO_TIMEZONE=UTC

# --- Kobo → EspoCRM bridge -------------------------------------------------------------
# Which form becomes which cases: templates/<name>.toml (fields, teams, routing)
BRIDGE_TEMPLATE=health-referral
# A Kobo account that can view the form's submissions (on the rig: the e2e user)
KOBO_TOKEN_FILE=/root/e2e-token
KOBO_URL=http://kf.kobo.local
BRIDGE_POLL_SECONDS=30
