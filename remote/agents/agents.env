# Agent settings (W4). Edit, then `./agents.sh up`. See agents/README.md.

# --- The agent model (its own llama-server, separate from KPI's batch model) ----------
#   gemma-4-26B-A4B-it-Q4_0.gguf  ~15 GB, a 20 GB GPU (or 32 GB+ unified memory)
#   gpt-oss-120b-MXFP4.gguf       ~63 GB, an 80 GB GPU or a 128 GB unified-memory box
AGENT_MODEL=gemma-4-26B-A4B-it-Q4_0.gguf
# kobo-mcp's tools (~15k tokens for analysis,forms,data) + OpenCode's prompt + the task
AGENT_CTX=65536
# Parallel slots: one per concurrent agent session (each gets AGENT_CTX / slots)
AGENT_SLOTS=1
AGENT_NGL=99
AGENT_THREADS=8

# Where OpenCode reaches the agent model. The local agent-llm container by default; for
# a model on another machine (e.g. a GPU droplet), its URL, ending in /v1.
AGENT_LLM_URL=http://agent-llm:8080/v1

# --- kobo-mcp (W3 settings) ---------------------------------------------------------
# Source tree to build kobo-mcp's image from (branch w3-offline-box or later)
KOBO_MCP_SRC=/root/kobo-mcp-src
TOOL_PROFILES=analysis,forms,data

# --- OpenCode -------------------------------------------------------------------------
OPENCODE_VERSION=1.19.5
# Basic auth for `opencode serve` / web. Set a real one on a box staff can reach.
OPENCODE_SERVER_PASSWORD=change-me
