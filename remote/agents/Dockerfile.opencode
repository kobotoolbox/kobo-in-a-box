# OpenCode for the box, with the analysis sandbox's basics (PLAN 3d): its shell and
# file tools run in this container, and nothing can be installed once offline.
# Build online; the image then runs with no internet.
FROM node:22-bookworm-slim
ARG OPENCODE_VERSION
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       python3 python3-pandas python3-matplotlib python3-openpyxl ca-certificates git ripgrep \
    && rm -rf /var/lib/apt/lists/*
RUN npm install -g "opencode-ai@${OPENCODE_VERSION}" && npm cache clean --force
WORKDIR /workspace
EXPOSE 4096
CMD ["opencode", "serve", "--hostname", "0.0.0.0", "--port", "4096"]
