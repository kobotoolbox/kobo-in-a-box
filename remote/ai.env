# Inference settings. Edit, then `./ai.sh up <gpu|cpu>` to apply.

# hf-repo:file pairs fetched by bootstrap.sh into /opt/models
MODEL_DOWNLOADS="
ggml-org/gemma-4-E4B-it-GGUF:gemma-4-E4B-it-Q4_0.gguf
ggml-org/gemma-4-E4B-it-GGUF:mmproj-gemma-4-E4B-it-Q8_0.gguf
ggml-org/gemma-4-26B-A4B-it-GGUF:gemma-4-26B-A4B-it-Q4_0.gguf
ggerganov/whisper.cpp:ggml-large-v3-turbo-q8_0.bin
ggerganov/whisper.cpp:ggml-medium-q5_0.bin
"

# --- LLM (translation + qual analysis) -------------------------------------
#   E4B Q4_0      ~4.6GB  fits an 8GB laptop GPU alongside whisper
#   26B-A4B Q4_0  ~14.6GB needs the 20GB GPU, or 32GB+ RAM on CPU
LLM_MODEL=gemma-4-E4B-it-Q4_0.gguf
# Set to the mmproj file to enable audio input (Gemma-as-ASR experiments); empty to disable
LLM_MMPROJ=mmproj-gemma-4-E4B-it-Q8_0.gguf
LLM_CTX=16384
# Gemma 4 thinking mode (true/false). On, it adds ~200-500 hidden tokens per KPI
# call (~40s on CPU). Set via the chat template: `--reasoning-budget 0` does NOT
# work for Gemma 4, the reasoning leaks into the answer and KPI's parser fails.
LLM_THINKING=false
# Layers offloaded to GPU: 99 = all. Lower it to simulate a smaller laptop GPU.
LLM_NGL=99
# CPU threads. Set to the target laptop's physical core count for CPU-tier tests.
LLM_THREADS=8

# --- Whisper (transcription) -----------------------------------------------
WHISPER_MODEL=ggml-large-v3-turbo-q8_0.bin
WHISPER_THREADS=8

# --- Resource caps to mimic the target laptop --------------------------------
# Applied to the AI containers only; leave headroom for the Kobo stack (~4-6GB).
AI_MEM_LIMIT=20g
AI_CPUS=8
