# The knowledge base on the box (W10). Edit, then `./knowledge.sh up`. See README.md.

# Built online by `./knowledge.sh build` (the image, and the embedding model into
# MODELS_DIR), then saved into the content pack with the index
KNOWLEDGE_IMAGE=kobo-knowledge:box
EMBED_IMAGE=ghcr.io/ggml-org/llama.cpp:server
# bge-m3 (MIT): 1024-d, 100+ languages, so a question in Swahili finds an English page
EMBED_DOWNLOAD=gpustack/bge-m3-GGUF:bge-m3-Q8_0.gguf
EMBED_MODEL=bge-m3-Q8_0.gguf
EMBED_THREADS=4
MODELS_DIR=/opt/models

# The reranker (bge-reranker-v2-m3, Apache 2.0): reorders the first 10 results. RERANK=1 to
# use it; on a CPU it costs seconds a question (measured in README.md)
RERANK=0
RERANK_DOWNLOAD=gpustack/bge-reranker-v2-m3-GGUF:bge-reranker-v2-m3-Q8_0.gguf
RERANK_MODEL=bge-reranker-v2-m3-Q8_0.gguf
# Where the knowledge service reaches the models: these containers, or (a test rig) another
# machine's llama-servers, e.g. a GPU droplet's
EMBED_URL=http://embed:8080
RERANK_URL_REMOTE=

# The index: built on the rig, shipped in the pack (knowledge/), one SQLite file
KNOWLEDGE_DIR=/opt/knowledge
LIBRARY_DIR=/srv/library

# Published on loopback only; the edge nginx serves it as http://knowledge.kobo.local
KNOWLEDGE_PORT=8088
