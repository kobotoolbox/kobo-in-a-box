 class BedrockClient(ABC):
 
@@ -167,4 +180,78 @@ class RuntimeClient(BedrockClient):
             ) from e
 
 
-CLIENTS_BY_NAME = {'mantle': MantleClient, 'runtime': RuntimeClient}
+class LocalClient(BedrockClient):
+    """
+    Sends qual to the OpenAI-compatible `/v1/chat/completions` endpoint at
+    `LOCAL_LLM_URL` (e.g. llama.cpp's llama-server). No AWS region or credentials
+    are needed, so it works offline
+    """
+
+    @staticmethod
+    def to_chat_completion(request_data: dict) -> dict:
+        if 'messages' in request_data:
+            # A text request: already chat format, but for a Bedrock-only field
+            return {k: v for k, v in request_data.items() if k != 'anthropic_version'}
+        # An image request: one message in the Responses API's format (Mantle's).
+        # The image goes first: the prompts only refer to "the attached image", and
+        # with the image as the common prefix, llama-server reuses its encoding for
+        # every analysis question on the same image (~70s each on a CPU otherwise)
+        images, texts = [], []
+        for part in request_data['content']:
+            if part['type'] == 'input_image':
+                images.append(
+                    {'type': 'image_url', 'image_url': {'url': part['image_url']}}
+                )
+            else:
+                texts.append({'type': 'text', 'text': part['text']})
+        content = images + texts
+        return {
+            'max_tokens': MAX_TOKENS,
+            'temperature': MODEL_TEMPERATURE,
+            'messages': [{'role': request_data['role'], 'content': content}],
+        }
+
+    def make_request(self, request_data, model):
+        url = f"{settings.LOCAL_LLM_URL.rstrip('/')}/v1/chat/completions"
+        try:
+            response = requests.post(
+                url,
+                json=self.to_chat_completion(request_data),
+                timeout=(
+                    settings.LOCAL_LLM_CONNECT_TIMEOUT,
+                    settings.LOCAL_LLM_READ_TIMEOUT,
+                ),
+            )
+            response.raise_for_status()
+            return response.json()
+        except requests.RequestException as e:
+            raise self._error(e) from e
+
+    def process_response(self, response, model):
+        try:
+            text = model.get_response_text(response)
+        except (IndexError, KeyError, TypeError) as e:
+            raise self._error(e) from e
+        if request := get_current_request():
+            request.llm_response = {
+                'request_id': response.get('id', ''),
+                'model': response.get('model', model.model_id),
+            }
+        return text
+
+    @staticmethod
+    def _error(e: Exception) -> InvalidResponseFromLLMException:
+        if request := get_current_request():
+            request.llm_response = {
+                'error': 'Unable to get an answer from the local LLM',
+            }
+        return InvalidResponseFromLLMException(
+            f'Unable to get an answer from the local LLM: {e}'
+        )
+
+
+CLIENTS_BY_NAME = {
+    'local': LocalClient,
+    'mantle': MantleClient,
+    'runtime': RuntimeClient,
+}
